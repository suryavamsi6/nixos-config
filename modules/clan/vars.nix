# Clan vars: where secrets live and who can decrypt them.
#
# `age` is the store. The clan key (`<flake>/.clan-secrets/.age/key.txt`) decrypts
# locally; each host's own key decrypts on the host. Nothing is stored in this
# repo except the encrypted `vars/*.age` files and the public recipients below.
#
# Secrets are read into place by systemd units generated by Clan, so a host that
# has no generated secret yet simply evaluates with the generator's placeholder —
# enabling this file does not break `nh os switch`.
#
# See plans/clan-deploy-rs-migration.md §6 for the generator → service mapping.
{ ... }:
{
  flake.clan = {
    vars.settings = {
      secretStore = "age";

      # Populated in Step 6 with `clan vars keygen` output for the admin machine
      # (the workstation) and for each host. Until then the list is empty, which
      # Clan accepts: no secrets are declared yet.
      recipients.default = [ ];
      recipients.hosts = { };
    };
  };
}
