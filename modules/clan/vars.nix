# Clan vars: where secrets live and who can decrypt them.
#
# `age` is the store, and it lives *outside* this repo. `suryavamsi6/nixos-config`
# is public, so `vars.settings.age.externalStore = true` and the encrypted blobs sit
# in $CLAN_AGE_STORE_DIR (~/clan-secrets by default for this workstation). Clan
# refuses to run if that variable points inside the flake, which is the guard we
# want: a mis-set variable fails loudly instead of publishing ciphertext.
#
# Recipients are the *user* keys that encrypt each machine's private age key.
# Secrets themselves are encrypted to the machine public keys, so adding a
# workstation only has to re-encrypt machine keys, never every secret.
#
# `deploy .#homelab` does NOT upload vars (deploy-rs knows nothing about them).
# With an external store the ciphertext is not in the system closure either, so
# a deploy that changes a secret needs `clan vars upload homelab` first. See
# docs/homelab.md.
#
# Generators live in ./secrets.nix because they are per-machine NixOS
# configuration, not flake-level settings.
# See plans/clan-deploy-rs-migration.md §6 for the generator → service mapping.
{ ... }:
{
  flake.clan = {
    vars.settings = {
      secretStore = "age";

      age.externalStore = true;

      # The workstation's age key, generated by `clan vars keygen`. It is a
      # break-glass recipient: any machine's private key can be decrypted with
      # it, so losing a host does not lock the fleet.
      recipients.default = [ "age1hvuc968kwrqvy9u0v33th0uc5n0r5099cf325ggfrt950nz85uvq7t5hnt" ];

      # Per-host lists would replace the default above. Empty means every
      # machine uses `default`, which is what a single-admin fleet wants.
      recipients.hosts = { };
    };
  };
}
