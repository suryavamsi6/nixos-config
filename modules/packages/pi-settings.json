{
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 12000
  },
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@narumitw/pi-lsp",
    "npm:pi-subagents",
    "npm:pi-linehash-edit",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-zentui",
    "npm:pi-memory",
    "npm:@sherif-fanous/pi-rtk",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-background-tasks",
    "npm:context-mode",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "npm:@narumitw/pi-usage",
    "npm:pi-opencode-free",
    "npm:@agent-sh/computer-use-linux",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-agent-browser-native",
    "npm:@henryqw/pi-task-models",
    "npm:@henryqw/pi-herdr",
    "npm:@henryqw/pi-herdr-rename",
    "npm:pi-cache-optimizer",
    "npm:pi-stats-dashboard",
    "npm:billion-context",
    "npm:pi-goal-x",
    "npm:@dietrichgebert/ponytail",
    "npm:@ramarivera/pi-supermemory",
    "git:github.com/nagisanzenin/engram"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": { "model": "bifrost/opencode-go/mimo-v2.6-flash", "thinking": "low" },
      "delegate": { "model": "bifrost/opencode-go/minimax-m3.1-flash", "thinking": "medium" },
      "researcher": { "model": "bifrost/opencode-go/kimi-k3.1-pro", "thinking": "high" },
      "worker": { "model": "bifrost/opencode-go/deepseek-v4.1-flash", "thinking": "medium" },
      "reviewer": { "model": "bifrost/opencode-go/glm-5.3", "thinking": "high" },
      "oracle": { "model": "bifrost/opencode-go/deepseek-v4-pro", "thinking": "high" },
      "advisor": { "model": "bifrost/opencode-go/qwen3.8-max", "thinking": "high" }
    }
  },
  "quietStartup": true,
  "clearOnStart": true,
  "hideThinkingBlock": true,
  "ccHeader": { "color": "c", "ver": 1, "grad": true, "lines": true, "pkg": false, "speed": 50, "slogan": "Code something that makes you proud", "sloganOn": true, "sloganColor": true, "disabled": false },
  "tuiMode": "fullscreen",
  "showHardwareCursor": false,
  "terminal": { "showTerminalProgress": false }
}
